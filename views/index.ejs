<%- include('layout/header') %>

<div class="container mt-4 table-responsive">

  <%- include('partials/message') %>

  <% if (products.length > 0) { %>
  <table class="table table-bordered table-striped my-3">
    <thead class="table-dark ">
      <tr>
        <th>N</th>
        <th class="centered">Image</th>
        <th>Product Name</th>
        <th>Price</th>
        <th>Category</th>
        <th>Quantity</th>
        <th class="centered">Action</th>
      </tr>
    </thead>

    <tbody class="align-middle">
      <% products.forEach((product, index) => { %>
      <tr>
        <td><%= index + 1 %></td>
        <td class="centered">
          <img src="/uploads/<%= product.image %>" width="60" height="50" class="rounded">
        </td>
        <td><%= product.name.charAt(0).toUpperCase() + product.name.slice(1)%></td>
        <td><%= product.price %>$</td>
        <td><%= product.category.charAt(0).toUpperCase() + product.category.slice(1) %></td>
        <td><%= product.quantity %></td>
        <td class="centered">
          <a href="/edit/<%= product._id %>" class="text-success"><i class="fas fa-edit fa-lg mx-1"></i></a>
          <a href="/delete/<%= product._id %>" class="text-danger"><i class="fas fa-trash fa-lg mx-1"></i></a>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% } else { %>
  <h3 class="text-center text-muted">No produdcts</h3>
  <% } %>

</div>

<%- include('layout/footer') %>