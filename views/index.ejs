<%- include('layout/header') %>

<div class="container mt-4 responsive" >

  <%- include('partials/message') %>

  <% if (users.length > 0) { %>
    <table class="table table-striped my-3">
      <thead class="table-dark">
        <tr>
          <th>#</th>
          <th>Image</th>
          <th>Name</th>
          <th>Email</th>
          <th>Phone</th>
          <th>Action</th>
        </tr>
      </thead>

      <tbody class="align-middle">
        <% users.forEach((user, index) => { %>
          <tr>
            <td><%= index + 1 %></td>
            <td>
              <img src="/uploads/<%= user.image %>" width="50" class="rounded">
            </td>
            <td><%= user.name %></td>
            <td><%= user.email %></td>
            <td><%= user.phone %></td>
            <td>
                <a href="/edit/<%= user._id %>" class="text-success"
                  ><i class="fas fa-edit fa-lg mx-1"></i
                ></a>
                <a href="/delete/<%= user._id %>" class="text-danger"
                  ><i class="fas fa-trash fa-lg mx-1"></i
                ></a>
              </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <h3 class="text-center text-muted">No users</h3>
  <% } %>

</div>

<%- include('layout/footer') %>