<%- include('layout/header') %>
<div class="container">
  <div class="row">
    <div class="col-lg-6 mx-auto mt-4">
      <div class="card shadow">
        <div class="card-header bg-primary">
          <h3 class="text-light"><%=title%></h3>
        </div>
        <div class="card-body p-4">
          <form action="/edit/<%=product._id%>" method="post" id="add-form" enctype="multipart/form-data">
            <div class="mb-3">
              <label for="name">Product Name</label>
              <input value="<%=product.name %>" type="text" name="name" class="form-control form-control-lg" placeholder="Product Name" required />
            </div>
            <div class="mb-3">
              <label for="price">Price</label>
              <input value="<%=product.price %>" type="number" name="price" class="form-control form-control-lg" placeholder="Price" required />
            </div>
            <div class="mb-3">
              <label for="category">Category</label>
              <select value="<%=product.category %>" name="category" class="form-select form-select-lg" required>
                <option value="">Select Category</option>
                <option value="electronics" <% if (product.category === 'electronics') { %>selected<% } %>>Electronics</option>
                <option value="clothes" <% if (product.category === 'clothes') { %>selected<% } %>>Clothes</option>
                <option value="food" <% if (product.category === 'food') { %>selected<% } %>>Food</option>
                <option value="grocery" <% if (product.category === 'grocery') { %>selected<% } %>>Grocery</option>
              </select>
            </div>
            <div class="mb-3">
              <label for="quantity">Quantity</label>
              <input value="<%=product.quantity %>" type="number" name="quantity" class="form-control form-control-lg" placeholder="Quantity" required />
            </div>
            <div class="mb-3">
              <label for="image" class="form-label">Select Image</label>

              <input type="file" name="image" class="form-control form-control-lg" />
              <img src="/uploads/<%= product.image %>" width="100" class="mb-2">

            </div>
            <div class="mb-3 d-grid">
              <input type="hidden" name="old_image" value="<%= product.image %>">
              <input type="submit" name="submit" value="Edit Product" class="btn btn-primary btn-lg" />
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('layout/footer') %>